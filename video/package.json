{
  "name": "msavin-php-video",
  "private": true,
  "scripts": {
    "assets:readonly": "bash scripts/prepare-readonly-assets.sh",
    "studio": "remotion studio src/index.ts",
    "check": "tsc --noEmit",
    "render:readonly:dev": "remotion render src/index.ts ReadonlyInterviewDev ../renders/readonly-remotion-dev.mp4 --codec=h264 --crf=18",
    "render:readonly": "remotion render src/index.ts ReadonlyInterview ../renders/readonly-remotion.mp4 --codec=h264 --crf=18",
    "render:readonly:short:dev": "remotion render src/index.ts ReadonlyInterviewShortDev ../renders/readonly-remotion-short-dev.mp4 --codec=h264 --crf=18",
    "render:readonly:short": "remotion render src/index.ts ReadonlyInterviewShort ../renders/readonly-remotion-short.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@remotion/media": "4.0.520",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.520"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.520",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
