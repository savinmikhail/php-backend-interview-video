# Shared caption pipeline defaults. Keep secrets in .env.local.
OPENAI_BASE_URL=https://api.openai.com/v1
CAPTIONS_LANGUAGE=ru
CAPTIONS_DIARIZE_MODEL=gpt-4o-transcribe-diarize
CAPTIONS_WORD_MODEL=whisper-1
CAPTIONS_MAX_UPLOAD_BYTES=24000000
CAPTIONS_MAX_AUDIO_BITRATE_KBPS=64
CAPTIONS_MIN_AUDIO_BITRATE_KBPS=32
CAPTIONS_MAX_CHUNK_SECONDS=600
CAPTIONS_API_CONCURRENCY=2
CAPTIONS_MAX_CHARS_PER_LINE=42
CAPTIONS_MAX_LINES=2
CAPTIONS_MAX_CUE_DURATION_MS=6000
CAPTIONS_SILENCE_BREAK_MS=650
CAPTIONS_MIN_CUE_DURATION_MS=700
CAPTIONS_SPEAKER_GLITCH_MS=350
